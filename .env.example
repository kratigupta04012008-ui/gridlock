# GRID LOCK — Environment Configuration Example
# Copy this file to .env and insert your real API key.

# Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here

# Model options
# Recommended: gemini-3.1-flash-lite (high throughput, fast latency, active for new keys)
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_S=10.0
LLM_TEMPERATURE=0.0
