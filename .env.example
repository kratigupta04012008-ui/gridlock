# GRID LOCK — Environment Configuration Example
# Copy this file to .env and insert your real API key.

# Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (Get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here

# Model options
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_S=5.0
LLM_TEMPERATURE=0.0
